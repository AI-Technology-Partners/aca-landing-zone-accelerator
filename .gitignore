# AITP LibreChat Azure Container Apps Landing Zone
# Terraform and Azure specific ignores

# Terraform files
*.tfstate
*.tfstate.*
*.tfvars.json
*.tfplan
.terraform/
.terraform.lock.hcl
terraform.rc
.terraformrc

# Azure CLI
.azure/

# IDE and Editor files
.vscode/
.vs/
*.local.*
.idea/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files
*.log
logs/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Environment files (may contain sensitive information)
.env
.env.local
.env.*.local

# Certificate files (keep out of version control)
*.pfx
*.p12
*.key
*.pem
*.crt
*.cer

# Backup files
*.bak
*.backup

# Build outputs
dist/
build/
target/

# Node modules (if any Node.js tools are used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if any Python tools are used)
__pycache__/
*.py[cod]
*$py.class
*.so
